---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPostEn from '../../../layouts/BlogPostEn.astro';
import type { RelatedPost } from '../../../components/RelatedPosts.astro';

export const prerender = true;


export async function getStaticPaths() {
	// Mapping EN slug → FR slug for hreflang
	const enToFrSlugMap: Record<string, string> = {
		'automating-ebike-charging-off-peak-hours': 'automatisation-recharge-velo-heures-creuses',
		'ebike-charging-reminder-home-assistant': 'rappel-recharge-velo-electrique-home-assistant',
		'home-assistant-mistakes-to-avoid': 'home-assistant-erreurs-a-eviter',
		'smart-plugs-savings-automations': 'prises-connectees-economies-automatisations',
		'tado-review-2-years-gas-savings': 'tado-retour-2-ans-economies-gaz',
		'wall-mounted-home-assistant-tablet': 'tablette-murale-home-assistant',
	};

	const allPosts = (await getCollection('blogEn')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);
	const publishedPosts = allPosts.filter(({ data }) => data.draft !== true);

	const toCard = (post: (typeof publishedPosts)[number]) => ({
		slug: post.id,
		title: post.data.title,
		h1: post.data.h1,
		description: post.data.description,
		heroImage: post.data.heroImage,
	});

	// À lire ensuite : les articles choisis dans `related`, complétés par les plus récents
	const relatedFor = (post: (typeof publishedPosts)[number]) => {
		const others = publishedPosts.filter((candidate) => candidate.id !== post.id);
		const picked = (post.data.related ?? [])
			.map((slug) => others.find((candidate) => candidate.id === slug))
			.filter((candidate) => candidate !== undefined);
		const fill = others.filter((candidate) => !picked.includes(candidate));
		return [...picked, ...fill].slice(0, 3).map(toCard);
	};

	// Les brouillons ne sont générés qu'en local
	const builtPosts = import.meta.env.PROD ? publishedPosts : allPosts;

	return builtPosts.map((post) => ({
		params: { slug: post.id },
		props: {
			...post,
			relatedPosts: relatedFor(post),
			frSlug: enToFrSlugMap[post.id],
		},
	}));
}

type Props = CollectionEntry<'blogEn'> & { relatedPosts: RelatedPost[]; frSlug?: string };

const post = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPostEn
	{...post.data}
	relatedPosts={post.relatedPosts}
	frSlug={post.frSlug}
	content={post.body}
	headings={headings}
>
	<Content />
</BlogPostEn>
