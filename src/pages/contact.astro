---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import ContactForm from '../components/ContactForm.astro';

const siteUrl = Astro.site?.href ?? Astro.url.origin;
const alternates = [
	{ hreflang: 'fr', href: new URL('/contact', siteUrl).href },
	{ hreflang: 'en', href: new URL('/en/contact', siteUrl).href },
];
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={`Contact - ${SITE_TITLE}`} description="Contactez The Optimization Guy" alternates={alternates} />
	</head>
	<body>
		<Header langHref="/en/contact" />
		<main>
			<h1>💭 Une question, une idée ?</h1>
			<p>
				Vous voulez réagir à un article, partager votre propre automatisation ou poser une question sur votre installation ? Laissez-moi un message via le formulaire ci-dessous.
			</p>
			
			<ContactForm lang="fr" />
		</main>
		<Footer />

		<!-- Google Tag Manager - Deferred loading for better performance -->
		<script is:inline>
			const loadGTM = () => {
				const gtmScript = document.createElement('script');
				gtmScript.async = true;
				gtmScript.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-PTBBTWQV';
				document.head.appendChild(gtmScript);
				window.dataLayer = window.dataLayer || [];
				window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
			};
			if ('requestIdleCallback' in window) {
				requestIdleCallback(loadGTM, { timeout: 3000 });
			} else {
				setTimeout(loadGTM, 2000);
			}
		</script>
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PTBBTWQV" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
	</body>
</html>
<style>
	main {
		margin: auto;
		padding: 1rem;
		width: 800px;
		max-width: calc(100% - 2rem);
		color: rgb(var(--gray-dark));
		font-size: 20px;
		line-height: 1.6;
	}
	h1 {
		font-size: 3rem;
		font-weight: 700;
		line-height: 1;
		margin-bottom: 0.5em;
		margin-top: 1em;
	}
	p {
		margin-bottom: 2em;
	}
</style>
