---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { frToEnSlugMap } from '../../translations.mjs';
import type { RelatedPost } from '../../components/RelatedPosts.astro';

export const prerender = true;


export async function getStaticPaths() {
	const allPosts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);
	const publishedPosts = allPosts.filter(({ data }) => data.draft !== true);

	const toCard = (post: (typeof publishedPosts)[number]) => ({
		slug: post.id,
		title: post.data.title,
		h1: post.data.h1,
		description: post.data.description,
		heroImage: post.data.heroImage,
	});

	// À lire ensuite : les articles choisis dans `related`, complétés par les plus récents
	const relatedFor = (post: (typeof publishedPosts)[number]) => {
		const others = publishedPosts.filter((candidate) => candidate.id !== post.id);
		const picked = (post.data.related ?? [])
			.map((slug) => others.find((candidate) => candidate.id === slug))
			.filter((candidate) => candidate !== undefined);
		const fill = others.filter((candidate) => !picked.includes(candidate));
		return [...picked, ...fill].slice(0, 3).map(toCard);
	};

	// Les brouillons ne sont générés qu'en local
	const builtPosts = import.meta.env.PROD ? publishedPosts : allPosts;

	return builtPosts.map((post) => ({
		params: { slug: post.id },
		props: {
			...post,
			relatedPosts: relatedFor(post),
			enSlug: frToEnSlugMap[post.id],
		},
	}));
}

type Props = CollectionEntry<'blog'> & { relatedPosts: RelatedPost[]; enSlug?: string };

const post = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost
	{...post.data}
	relatedPosts={post.relatedPosts}
	enSlug={post.enSlug}
	content={post.body}
	headings={headings}
>
	<Content />
</BlogPost>
