<!doctype html>
<html lang="fr">
	<head>
		<BaseHead
			title="Mon matériel domotique Home Assistant - The Optimization Guy"
			description="Liste complète du matériel domotique que j'utilise au quotidien : caméras, capteurs, chauffage connecté, et mes recommandations."
			alternates={alternates}
			image={heroImg.src}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
	</head>
	<body>
			<Header langHref="/en/my-equipment" />
			<section class="hero-split" aria-label="Intro">
				<div class="hero-split__grid">
					<figure class="hero-split__media">
						<Image
							src={heroImg}
							alt="Mon matériel domotique Home Assistant (installé et testé chez moi)"
							width={1200}
							height={900}
							loading="eager"
							fetchpriority="high"
							format="webp"
							quality={85}
							class="hero-split__image"
						/>
					</figure>

					<div class="hero-split__content">
						<p class="hero-split__kicker">
							Matériel acheté, installé et testé
						</p>

						<h1 class="hero-split__title">
							Mon matériel domotique
						</h1>

						<p class="hero-split__intro">
							Voici le matériel domotique que j'utilise réellement chez moi avec Home Assistant.
							Tout a été acheté par mes soins, installé et testé sur la durée. J'ai commencé par
							optimiser le chauffage, puis j'ai équipé la maison en Tapo, avant de migrer
							progressivement vers un écosystème Zigbee plus fiable.
						</p>

						<ul class="hero-split__stats">
							{heroStats.map((stat) => (
								<li>
									<strong>{stat.value}</strong>
									<span>{stat.label}</span>
								</li>
							))}
						</ul>
					</div>
				</div>
			</section>
		<main class="equipment-main">
			<EquipmentCatalog sections={sections} />
		</main>
		<Footer />

		<!-- Google Tag Manager - Deferred loading for better performance -->
		<script is:inline>
			const loadGTM = () => {
				const gtmScript = document.createElement('script');
				gtmScript.async = true;
				gtmScript.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-PTBBTWQV';
				document.head.appendChild(gtmScript);
				window.dataLayer = window.dataLayer || [];
				window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
			};
			if ('requestIdleCallback' in window) {
				requestIdleCallback(loadGTM, { timeout: 3000 });
			} else {
				setTimeout(loadGTM, 2000);
			}
		</script>
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PTBBTWQV" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
	</body>
</html>

<style is:global>
	/* Désactiver le gradient du body pour cette page */
	:root {
		--equipment-max-width: 1200px;
		--equipment-gutter: 1em;
	}

	body {
		background: white !important;
		background-size: auto !important;
	}

	.dark body {
		background: rgb(17, 24, 39) !important;
	}
</style>

	<style>
		.hero-split,
		.equipment-main {
			box-sizing: border-box;
			width: min(100%, var(--equipment-max-width));
			margin: 0 auto;
			padding-inline: var(--equipment-gutter);
		}

		.hero-split {
			padding-block: 2rem 1.5rem;
		}

		.hero-split__grid {
			display: grid;
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.hero-split__media {
			order: 2;
			margin: 0;
		}

		.hero-split__image {
			width: 100%;
			display: block;
			border-radius: 1rem;
			border: 1px solid rgba(0, 0, 0, 0.1);
			box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
			aspect-ratio: 16 / 9;
			object-fit: cover;
			background: rgba(0, 0, 0, 0.05);
		}

		:global(.dark) .hero-split__image {
			border-color: rgba(255, 255, 255, 0.1);
			background: rgba(255, 255, 255, 0.05);
		}

		.hero-split__content {
			order: 1;
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		.hero-split__kicker {
			margin: 0;
			font-size: 0.75rem;
			font-weight: 600;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: rgba(0, 0, 0, 0.6);
		}

		:global(.dark) .hero-split__kicker {
			color: rgba(255, 255, 255, 0.6);
		}

		.hero-split__title {
			font-size: clamp(1.9rem, 2.6vw, 2.5rem);
			line-height: 1.2;
			font-weight: 600;
			margin: 0;
		}

		.hero-split__intro {
			color: rgba(0, 0, 0, 0.7);
			max-width: 65ch;
			margin: 0;
		}

		:global(.dark) .hero-split__intro {
			color: rgba(255, 255, 255, 0.7);
		}

		.hero-split__stats {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin: 0.25rem 0 0;
			padding: 0;
			list-style: none;
		}

		.hero-split__stats li {
			display: flex;
			flex-direction: column;
			min-width: 7.5rem;
			margin: 0;
			padding: 0.75rem 1rem;
			border: 1px solid rgba(var(--gray), 0.18);
			border-radius: 12px;
			background: rgba(var(--accent), 0.08);
			line-height: 1.2;
		}

		.hero-split__stats strong {
			color: rgb(var(--black));
			font-size: 1.6rem;
		}

		.hero-split__stats span {
			color: rgb(var(--gray));
			font-size: 0.8rem;
		}

		@media (min-width: 1024px) {
			.hero-split__grid {
				grid-template-columns: repeat(2, minmax(0, 1fr));
				align-items: center;
				gap: 2.5rem;
			}

			.hero-split__media {
				order: 1;
			}

			.hero-split__image {
				aspect-ratio: 4 / 3;
			}
		}

		.equipment-main {
			padding-block: 1rem 4em;
		}

	@media (max-width: 720px) {
		.hero-split {
			padding-block: 1.5rem 1rem;
		}

		.hero-split__stats li {
			flex: 1 1 0;
			min-width: 0;
			padding: 0.6rem 0.75rem;
		}

		.hero-split__stats strong {
			font-size: 1.35rem;
		}
	}
</style>
