---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FooterEn from '../components/FooterEn.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import HeaderEn from '../components/HeaderEn.astro';

interface Props {
	lang: 'fr' | 'en';
}

const { lang } = Astro.props;
const isEn = lang === 'en';

const t = isEn
	? {
			title: 'The Optimization Guy | Smart Home & Home Assistant Blog',
			description:
				'A smart home blog for Home Assistant enthusiasts: automation ideas, integrations, dashboards, sensors and useful hacks — optimized without the headaches.',
			intro: [
				'I share here what I set up at home in terms of smart home automation: automations, Home Assistant integrations, energy monitoring and daily comfort improvements.',
				"You'll find detailed real-world use cases, ready-to-adapt code and honest feedback on what works… and what doesn't, all with one obsession: optimize without over-complicating.",
			],
			latest: 'Latest Posts',
			loadMore: 'Load more articles',
			about: 'More about me',
			blogPath: '/en/blog/',
			aboutPath: '/en/about',
			contactPath: '/en/contact',
		}
	: {
			title: 'The Optimization Guy | Blog Domotique & Home Assistant',
			description:
				"Blog domotique pour s'amuser avec Home Assistant : idées d'automatisations, intégrations, dashboards, capteurs et bidouilles utiles 🤓🏠",
			intro: [
				"Je partage ici ce que je mets en place chez moi en matière de domotique : automatisations, intégrations Home Assistant, suivi de l'énergie et amélioration du confort au quotidien.",
				"Vous y trouverez des cas d'usage détaillés, du code prêt à adapter et des retours d'expérience honnêtes sur ce qui fonctionne… et sur ce qui fonctionne moins bien, le tout avec une obsession : optimiser sans compliquer.",
			],
			latest: 'Dernières publications',
			loadMore: "Voir plus d'articles",
			about: 'En savoir plus sur moi',
			blogPath: '/blog/',
			aboutPath: '/about',
			contactPath: '/contact',
		};

const allPosts = (await getCollection(isEn ? 'blogEn' : 'blog', ({ data }) => {
	return data.draft !== true;
})).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const INITIAL_POSTS = 8;
const LOAD_MORE_COUNT = 6;

const siteUrl = Astro.site?.href ?? Astro.url.origin;
const frAlternate = { hreflang: 'fr', href: new URL('/', siteUrl).href };
const enAlternate = { hreflang: 'en', href: new URL('/en/', siteUrl).href };
const alternates = isEn ? [enAlternate, frAlternate] : [frAlternate, enAlternate];
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={t.title} description={t.description} alternates={alternates} />
	</head>
	<body>
		{isEn ? <HeaderEn /> : <Header />}
		<main>
			<aside class="intro">
				<img
					src="/hannibal-cercle.png"
					alt="Pierre - The Optimization Guy"
					class="intro-avatar"
					width="96"
					height="96"
				/>
				<h1>👋 Smart Home Lovers!</h1>
				<p>{t.intro[0]}</p>
				<p class="intro-more">{t.intro[1]}</p>
				<div class="intro-links">
					<a href={t.aboutPath} class="about-link">{t.about} →</a>
					<div class="social">
						<a href="https://x.com/OptimizGuy" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
								<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
							</svg>
						</a>
						<a href="https://www.reddit.com/user/Patient-Gene703/" target="_blank" rel="noopener noreferrer" aria-label="Reddit">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
								<path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/>
							</svg>
						</a>
						<a href={t.contactPath} aria-label="Contact">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<rect width="20" height="16" x="2" y="4" rx="2"/>
								<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
							</svg>
						</a>
					</div>
				</div>
			</aside>

			<section class="latest-posts">
				<h2>{t.latest}</h2>
				<ul id="posts-list">
					{allPosts.map((post, index) => {
						const slug = post.slug ?? post.id.replace(/\.mdx?$/, '');
						const displayTitle = post.data.h1 ?? post.data.title;
						const isHidden = index >= INITIAL_POSTS;

						return (
							<li class={isHidden ? 'post-item hidden' : 'post-item'} data-index={index}>
								<a href={`${t.blogPath}${slug}/`}>
									{post.data.heroImage && (
										<div class="post-image-wrap">
											<Image
												width={640}
												height={360}
												src={post.data.heroImage}
												alt={displayTitle}
												class="post-image"
												loading={index < 2 ? 'eager' : 'lazy'}
												fetchpriority={index === 0 ? 'high' : 'auto'}
												format="webp"
												quality={80}
											/>
										</div>
									)}
									<div class="content">
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3>{displayTitle}</h3>
										{post.data.description && <p class="description">{post.data.description}</p>}
									</div>
								</a>
							</li>
						);
					})}
				</ul>
				{allPosts.length > INITIAL_POSTS && (
					<div class="load-more-container">
						<button id="load-more-btn" data-total={allPosts.length} data-initial={INITIAL_POSTS} data-increment={LOAD_MORE_COUNT}>
							<span>{t.loadMore}</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="6 9 12 15 18 9"></polyline>
							</svg>
						</button>
					</div>
				)}
			</section>
		</main>
		{isEn ? <FooterEn /> : <Footer />}

		<!-- Google Tag Manager - Deferred loading for better performance -->
		<script is:inline>
			const loadGTM = () => {
				const gtmScript = document.createElement('script');
				gtmScript.async = true;
				gtmScript.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-PTBBTWQV';
				document.head.appendChild(gtmScript);
				window.dataLayer = window.dataLayer || [];
				window.dataLayer.push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
			};
			if ('requestIdleCallback' in window) {
				requestIdleCallback(loadGTM, { timeout: 3000 });
			} else {
				setTimeout(loadGTM, 2000);
			}
		</script>
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PTBBTWQV" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const loadMoreBtn = document.getElementById('load-more-btn');
				if (!loadMoreBtn) return;

				const total = parseInt(loadMoreBtn.dataset.total, 10);
				const initial = parseInt(loadMoreBtn.dataset.initial, 10);
				const increment = parseInt(loadMoreBtn.dataset.increment, 10);
				let visibleCount = initial;

				loadMoreBtn.addEventListener('click', () => {
					const posts = document.querySelectorAll('#posts-list .post-item');
					const newVisibleCount = Math.min(visibleCount + increment, total);

					for (let i = visibleCount; i < newVisibleCount; i++) {
						const post = posts[i];
						if (post) {
							post.classList.remove('hidden');
							post.classList.add('fade-in');
						}
					}

					visibleCount = newVisibleCount;

					if (visibleCount >= total) {
						loadMoreBtn.parentElement.style.display = 'none';
					}
				});
			});
		</script>
	</body>
</html>
<style>
	main {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
		grid-template-areas: 'posts intro';
		gap: 3rem;
		align-items: start;
		width: 1180px;
		max-width: calc(100% - 2rem);
		margin: auto;
		padding: 2rem 1rem 3rem;
		color: rgb(var(--gray-dark));
	}

	/* Colonne de présentation (droite) */
	.intro {
		grid-area: intro;
		position: sticky;
		top: 6rem;
		padding: 1.75rem 1.5rem;
		background: rgba(255, 208, 77, 0.06);
		border-left: 4px solid rgb(var(--accent));
		border-radius: 12px;
		font-size: 0.95rem;
		line-height: 1.6;
	}
	.intro-avatar {
		display: block;
		width: 96px;
		height: 96px;
		border-radius: 50%;
		border: 3px solid rgb(var(--accent));
		object-fit: cover;
		margin-bottom: 1rem;
	}
	.intro h1 {
		font-size: 1.6rem;
		line-height: 1.2;
		margin: 0 0 0.75rem;
	}
	:global(.dark) .intro h1 {
		color: rgb(255, 255, 255);
	}
	.intro p {
		margin: 0 0 0.85em;
	}
	:global(.dark) .intro p {
		color: rgb(209, 213, 219);
	}
	.intro-links {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-top: 1.25rem;
	}
	.about-link {
		font-weight: 700;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.about-link:hover {
		color: rgb(var(--accent-dark));
	}
	:global(.dark) .about-link:hover {
		color: rgb(var(--accent));
	}
	.social {
		display: flex;
		gap: 0.75rem;
	}
	.social a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: rgba(var(--gray), 0.12);
		color: rgb(var(--black));
		transition: all 0.2s ease;
	}
	.social a:hover {
		background: rgb(var(--accent));
		color: #000;
		transform: translateY(-2px);
	}
	.social svg {
		width: 18px;
		height: 18px;
	}

	/* Liste des articles (gauche) */
	.latest-posts {
		grid-area: posts;
	}
	.latest-posts h2 {
		font-size: 1.2rem;
		font-weight: 700;
		margin: 0 0 1.25rem;
	}
	.latest-posts ul {
		list-style-type: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem 1.75rem;
	}
	.latest-posts a {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}
	.post-image-wrap {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 10px;
		margin-bottom: 0.85rem;
		background: rgba(var(--gray), 0.1);
	}
	.latest-posts .post-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}
	.latest-posts a:hover .post-image {
		transform: scale(1.05);
	}
	.latest-posts .date {
		font-size: 0.8rem;
		color: rgb(var(--gray));
		margin: 0 0 0.25rem;
	}
	.latest-posts h3 {
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.3;
		margin: 0 0 0.5rem;
		color: rgb(var(--black));
		transition: color 0.2s;
	}
	:global(.dark) .latest-posts h3 {
		color: rgb(255, 255, 255);
	}
	.latest-posts a:hover h3 {
		color: rgb(var(--accent-dark));
	}
	:global(.dark) .latest-posts a:hover h3 {
		color: rgb(var(--accent));
	}
	.latest-posts .description {
		font-size: 0.95rem;
		line-height: 1.55;
		color: rgb(var(--gray-dark));
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	:global(.dark) .latest-posts .description {
		color: rgb(209, 213, 219);
	}

	/* Tablette / mobile : présentation compacte au-dessus des articles */
	@media (max-width: 960px) {
		main {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				'intro'
				'posts';
			gap: 2rem;
			padding-top: 1.5rem;
		}
		.intro {
			position: static;
			display: grid;
			grid-template-columns: 64px minmax(0, 1fr);
			column-gap: 1rem;
			align-items: center;
			padding: 1.25rem;
		}
		.intro-avatar {
			width: 64px;
			height: 64px;
			margin: 0;
		}
		.intro h1 {
			font-size: 1.35rem;
			margin: 0;
		}
		.intro p,
		.intro-links {
			grid-column: 1 / -1;
		}
		.intro p {
			margin: 0.85rem 0 0;
		}
		.intro-more {
			display: none;
		}
		.intro-links {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			flex-wrap: wrap;
			margin-top: 1rem;
		}
	}
	@media (max-width: 640px) {
		.latest-posts ul {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* Load More Button */
	.load-more-container {
		display: flex;
		justify-content: center;
		margin-top: 1.5em;
	}

	#load-more-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5em;
		padding: 0.75em 1.5em;
		font-size: 0.9rem;
		font-weight: 500;
		font-family: inherit;
		color: rgb(var(--gray));
		background-color: transparent;
		border: none;
		border-radius: 50px;
		cursor: pointer;
		transition: all 0.25s ease;
	}

	#load-more-btn svg {
		transition: transform 0.25s ease;
	}

	#load-more-btn:hover {
		color: rgb(var(--accent-dark));
		background-color: rgba(255, 208, 77, 0.15);
	}

	#load-more-btn:hover svg {
		transform: translateY(3px);
	}

	#load-more-btn:active {
		transform: scale(0.98);
	}

	:global(.dark) #load-more-btn {
		color: rgb(156, 163, 175);
	}

	:global(.dark) #load-more-btn:hover {
		color: rgb(var(--accent));
		background-color: rgba(255, 208, 77, 0.1);
	}

	/* Hidden posts */
	.post-item.hidden {
		display: none;
	}

	/* Fade in animation */
	.post-item.fade-in {
		animation: fadeIn 0.4s ease-out;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
