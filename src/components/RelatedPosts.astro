---
// Bloc "À lire ensuite" en fin d'article (FR et EN)
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export type RelatedPost = {
	slug: string;
	title: string;
	h1?: string;
	description: string;
	heroImage?: ImageMetadata;
};

interface Props {
	posts: RelatedPost[];
	lang?: 'fr' | 'en';
}

const { posts, lang = 'fr' } = Astro.props;

const t = {
	fr: { title: 'À lire ensuite', basePath: '/blog/', more: "Lire l'article" },
	en: { title: 'Read next', basePath: '/en/blog/', more: 'Read the article' },
}[lang];
---

{posts.length > 0 && (
	<section class="related" aria-labelledby="related-title">
		<p class="related__title" id="related-title">{t.title}</p>
		<ul class="related__list">
			{posts.map((post) => (
				<li>
					<a class="related__card" href={`${t.basePath}${post.slug}/`}>
						{post.heroImage && (
							<Image
								src={post.heroImage}
								alt=""
								width={480}
								height={270}
								loading="lazy"
								class="related__img no-lightbox"
							/>
						)}
						<span class="related__body">
							<span class="related__name">{post.h1 ?? post.title}</span>
							<span class="related__desc">{post.description}</span>
							<span class="related__more" aria-hidden="true">{t.more} →</span>
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>
)}

<style>
	.related {
		margin: 3rem 0 2.5rem;
	}

	.related__title {
		margin: 0 0 1rem !important;
		color: rgb(var(--black));
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.related__list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin: 0 !important;
		padding: 0 !important;
		list-style: none;
	}

	.related__list li {
		margin: 0 !important;
		padding: 0 !important;
	}

	.related__list li::before {
		content: none !important;
	}

	.related .related__card {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid rgba(var(--gray), 0.2);
		border-radius: 14px;
		background: rgba(var(--gray-light), 0.25);
		color: inherit;
		text-decoration: none;
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.related .related__card:hover {
		color: inherit;
		transform: translateY(-2px);
		border-color: rgba(var(--accent), 0.6);
		box-shadow: 0 10px 24px rgba(var(--gray), 0.18);
	}

	.related .related__card:focus-visible {
		outline: 3px solid rgba(var(--accent), 0.7);
		outline-offset: 2px;
	}

	.related__img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		margin: 0 !important;
		border-radius: 0 !important;
		box-shadow: none !important;
		object-fit: cover;
	}

	.related__body {
		display: flex;
		flex-direction: column;
		flex: 1;
		gap: 0.4rem;
		padding: 0.9rem 1rem 1rem;
	}

	.related__name {
		color: rgb(var(--black));
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.related__desc {
		display: -webkit-box;
		overflow: hidden;
		color: rgb(var(--gray));
		font-size: 0.8rem;
		line-height: 1.5;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
	}

	.related__more {
		margin-top: auto;
		padding-top: 0.25rem;
		color: rgb(var(--accent-dark));
		font-size: 0.8rem;
		font-weight: 700;
	}

	:global(.dark) .related__more {
		color: rgb(var(--accent));
	}

	@media (max-width: 720px) {
		.related__list {
			grid-template-columns: 1fr;
		}

		.related .related__card {
			flex-direction: row;
		}

		.related__img {
			flex: 0 0 104px;
			width: 104px;
			aspect-ratio: auto;
		}

		.related__desc {
			-webkit-line-clamp: 2;
		}

		.related__more {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.related .related__card {
			transition: none;
		}

		.related .related__card:hover {
			transform: none;
		}
	}
</style>
