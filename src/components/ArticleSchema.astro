---
import { PERSON_ID, SITE_URL, WEBSITE_ID, personRef, type Lang } from '../schema';

interface Props {
	title: string;
	headline?: string;
	description: string;
	image?: string;
	datePublished: Date | string;
	dateModified?: Date | string;
	author?: {
		name: string;
		url?: string;
	};
	canonicalUrl: string;
	lang: Lang;
	// URL de la version traduite de l'article (FR <-> EN)
	translationUrl?: string;
}

const {
	title,
	headline,
	description,
	image,
	datePublished,
	dateModified,
	author,
	canonicalUrl,
	lang,
	translationUrl,
} = Astro.props;

const toIso = (date: Date | string) => (typeof date === 'string' ? date : date.toISOString());

// Un auteur invité garde sa propre fiche, sinon on pointe vers la fiche de Pierre
const schemaAuthor =
	author?.name && author.name !== personRef.name
		? { '@type': 'Person', name: author.name, ...(author.url && { url: author.url }) }
		: personRef;

const homeUrl = lang === 'en' ? `${SITE_URL}/en/` : `${SITE_URL}/`;
const translationLang: Lang = lang === 'en' ? 'fr' : 'en';

const article = {
	'@type': 'BlogPosting',
	'@id': `${canonicalUrl}#article`,
	headline: headline || title,
	description,
	image: image || `${SITE_URL}/hannibal.jpg`,
	datePublished: toIso(datePublished),
	dateModified: toIso(dateModified ?? datePublished),
	inLanguage: lang,
	url: canonicalUrl,
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
	isPartOf: { '@id': WEBSITE_ID },
	author: schemaAuthor,
	publisher: { '@id': PERSON_ID },
	...(translationUrl && {
		[lang === 'en' ? 'translationOfWork' : 'workTranslation']: {
			'@type': 'BlogPosting',
			'@id': `${translationUrl}#article`,
			url: translationUrl,
			inLanguage: translationLang,
		},
	}),
};

const breadcrumb = {
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: lang === 'en' ? 'Home' : 'Accueil', item: homeUrl },
		{ '@type': 'ListItem', position: 2, name: headline || title, item: canonicalUrl },
	],
};

const schema = {
	'@context': 'https://schema.org',
	'@graph': [article, breadcrumb],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
