---
// Rangée de YouTube Shorts : une colonne par Short sur grand écran (3 Shorts = 3 colonnes),
// et sur téléphone une rangée qui défile au doigt, le Short suivant dépassant à droite.
// À remplir avec des <YouTube short />.
---

<div class="yt-shorts not-prose">
  <slot />
</div>

<style>
  .yt-shorts {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin: 1.5rem 0;
  }
  .yt-shorts > :global(*),
  .yt-shorts :global(.yt) {
    margin: 0;
  }
  @media (max-width: 560px) {
    .yt-shorts {
      grid-auto-columns: 62%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-bottom: 0.25rem;
    }
    .yt-shorts::-webkit-scrollbar {
      display: none;
    }
    .yt-shorts > :global(*) {
      scroll-snap-align: start;
    }
  }
</style>
